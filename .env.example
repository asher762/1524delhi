# MongoDB Atlas connection string (required for Vercel deployment)
# Format: mongodb+srv://user:password@cluster.mongodb.net/database-name
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/1524-delhi

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Your deployed URL — no trailing slash (e.g. https://1524-delhi.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token — get from Vercel Dashboard > Storage > Blob > your store
BLOB_READ_WRITE_TOKEN=YOUR_BLOB_TOKEN_HERE

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
