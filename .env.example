# Postgres connection string (required — the app uses @payloadcms/db-postgres)
# Format: postgresql://user:password@host:5432/database-name?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/1524-delhi?sslmode=require

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Your deployed URL — no trailing slash (e.g. https://1524-delhi.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token — get from Vercel Dashboard > Storage > Blob > your store
BLOB_READ_WRITE_TOKEN=YOUR_BLOB_TOKEN_HERE

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Mailchimp Transactional (Mandrill) — used as the Payload email adapter for internal
# notification emails (e.g. contact form alerts). Requires a Standard Mailchimp plan or
# higher plus a DKIM-verified sending domain. Get the API key from Mailchimp Transactional
# > Settings > SMTP & API Info.
MAILCHIMP_TRANSACTIONAL_API_KEY=YOUR_MANDRILL_API_KEY_HERE
MAILCHIMP_TRANSACTIONAL_FROM_EMAIL=noreply@1524delhi.com
MAILCHIMP_TRANSACTIONAL_FROM_NAME=1524 Delhi

# Internal recipient for the contact form notification email (not shown to visitors)
CONTACT_NOTIFICATION_EMAIL=YOUR_INTERNAL_EMAIL_HERE

# Mailchimp Marketing API — used for newsletter signup (adds contacts directly to an
# Audience with single opt-in, no confirmation email). Get the API key from Mailchimp
# Account > Extras > API keys. The server prefix is the suffix after the dash in the key
# (e.g. a key ending in "-us21" means the prefix is "us21").
MAILCHIMP_MARKETING_API_KEY=YOUR_MAILCHIMP_MARKETING_API_KEY_HERE
MAILCHIMP_MARKETING_SERVER_PREFIX=usXX
MAILCHIMP_AUDIENCE_ID=YOUR_MAILCHIMP_AUDIENCE_ID_HERE
